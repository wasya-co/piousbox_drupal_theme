
<div class="layout-container">

  {#
  {{ page.preheader }}
  <div class='headerW'>
    <header role="banner">
      {{ page.header }}
    </header>
    {{ page.primary_menu }}
    {{ page.secondary_menu }}
  </div>
  {{ page.breadcrumb }}
  {{ page.highlighted }}
  {{ page.help }}
  #}
  <h5>scene3d</h5>

  <main role="main">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    <div class="layout-content">
      {{ page.content }}
    </div>
  </main>

  {#
  {% if page.footer %}
    <footer role="contentinfo">
        {{ page.footer }}
    </footer>
  {% endif %}
  {% if page.postfooter %}
    <footer role="contentinfo" class="layout-postfooter" >
      <div class='maxwidth'>
        {{ page.postfooter }}
      </div>
    </footer>
  {% endif %}
  #}

</div>
